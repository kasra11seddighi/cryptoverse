# Environment variables template for CryptoVerse backend.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

REDIS_URL=

# CoinGecko Demo API key (sent as the x-cg-demo-api-key header). Server-side only: never prefix with VITE_, never commit a real value.
# If it is empty, /api/v1/market/* answers 503 and nothing is sent to CoinGecko.
COINGECKO_API_KEY=

# Optional market tuning (defaults shown). Uncomment to override.
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# COINGECKO_TIMEOUT_MS=8000
# COINGECKO_MAX_REQUESTS_PER_MINUTE=25
# MARKET_LIST_SIZE=250
# MARKET_RATE_LIMIT_PER_MINUTE=120

# Per-user request ceilings for portfolio, transactions and watchlist (defaults shown). Uncomment to override.
# ACCOUNT_RATE_LIMIT_PER_MINUTE=120
# TRADE_RATE_LIMIT_PER_MINUTE=30
